# Local dev only
.venv/
__pycache__/
*.py[cod]

# HTTP response cache (BIDS_CACHE=1) - never commit scraped upstream pages
.cache/

# Intermediate dump consumed by match_locations.py; regenerate with --raw
scrapers/.build/

# Local splice/verification scratch
.build/
.scratch/

# Google Places key for the local NH3 lookup - server-side key, never commit
.places-key

# Generated private map - contains field locations, never commit
dev/.private-preview.html
dev/.private-test.html
dev/cloudflare/.wrangler/
dev/cloudflare/node_modules/
